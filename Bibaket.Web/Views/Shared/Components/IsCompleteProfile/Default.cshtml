@model bool

@if (!Model)
{
    <div class="alert alert-warning alert-dismissible fade show mb-5" role="alert">
        <div>
            کاربر گرامی برای دسترسی به امکانات فروشگاه لطفا پروفایل خود را تکمیل کنید.
            <a asp-area="UserPanel" asp-controller="Profile" asp-action="EditProfile" class="btn btn-sm btn-primary mx-3">پروفایل من</a>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}