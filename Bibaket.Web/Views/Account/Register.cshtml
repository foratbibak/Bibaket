@using Bibaket.Domin.ViewModels.Account
@model RegisterViewModel
@{
    ViewData["Title"] = "ثبت نام";
}

<link rel="stylesheet" href="~/css/Custom.css" />

<div class="auth-page-container">
    <div class="auth-card">
        <div class="auth-card-header">
            <div class="auth-icon">
                <i class="fas fa-user-plus"></i>
            </div>
            <h2>ثبت نام</h2>
            <p>عضو جدید سایت شوید</p>
        </div>

        <div class="auth-card-body">
            <form asp-action="Register" class="auth-form">
                <div class="form-field">
                    <label asp-for="UserName" class="field-label">
                        <i class="fas fa-user"></i>
                        <span>نام کاربری</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="UserName" class="field-input" placeholder="نام کاربری را وارد کنید" />
                    </div>
                    <span asp-validation-for="UserName" class="field-error"></span>
                </div>
                <div class="form-field">
                    <label asp-for="Email" class="field-label">
                        <i class="fas fa-envelope"></i>
                        <span>ایمیل</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="Email" class="field-input dir-rtl" placeholder="ایمیل را وارد کنید" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Password" class="field-label">
                        <i class="fas fa-lock"></i>
                        <span>کلمه عبور</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="Password" class="field-input" type="password" placeholder="کلمه عبور را وارد کنید" />
                        <i class="fas fa-eye-slash password-toggle"></i>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="RePassword" class="field-label">
                        <i class="fas fa-check-circle"></i>
                        <span>تکرار کلمه عبور</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="RePassword" class="field-input" type="password" placeholder="تکرار کلمه عبور را وارد کنید" />
                        <i class="fas fa-eye-slash password-toggle"></i>
                    </div>
                    <span asp-validation-for="RePassword" class="field-error"></span>
                </div>

                <button type="submit" class="submit-button">
                    <i class="fas fa-user-plus"></i>
                    <span>ثبت نام</span>
                </button>

                <div class="auth-footer">
                    <div class="terms-text">
                        با ورود و یا ثبت نام در سایت شما <a href="#" class="terms-link">شرایط و قوانین</a> استفاده
                        از تمام سرویس‌های سایت و <a href="#" class="terms-link">قوانین حریم خصوصی</a> آن را می‌پذیرید.
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}