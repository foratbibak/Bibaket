@using Bibaket.Domin.ViewModels.Account
@model ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر کلمه عبور";
}


<div class="password-page-container">
    <div class="password-card">
        <div class="password-card-header">
            <div class="password-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h2>تغییر کلمه عبور</h2>
            <p>کلمه عبور خود را به‌روزرسانی کنید</p>
        </div>

        <div class="password-card-body">
            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="error-summary"></div>

                <div class="form-field">
                    <label asp-for="OldPassword" class="field-label">
                        <i class="fas fa-key"></i>
                        <span>@Html.DisplayNameFor(m => m.OldPassword)</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="OldPassword" class="field-input" type="password" />
                        <i class="fas fa-eye-slash password-toggle"></i>
                    </div>
                    <span asp-validation-for="OldPassword" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Password" class="field-label">
                        <i class="fas fa-shield-alt"></i>
                        <span>@Html.DisplayNameFor(m => m.Password)</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="Password" class="field-input" type="password" />
                        <i class="fas fa-eye-slash password-toggle"></i>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="RePassword" class="field-label">
                        <i class="fas fa-check-circle"></i>
                        <span>@Html.DisplayNameFor(m => m.RePassword)</span>
                    </label>
                    <div class="input-container">
                        <input asp-for="RePassword" class="field-input" type="password" />
                        <i class="fas fa-eye-slash password-toggle"></i>
                    </div>
                    <span asp-validation-for="RePassword" class="field-error"></span>
                </div>

                <button type="submit" class="submit-button">
                    <i class="fas fa-save"></i>
                    <span>بروزرسانی کلمه عبور</span>
                </button>
            </form>
        </div>
    </div>
</div>

