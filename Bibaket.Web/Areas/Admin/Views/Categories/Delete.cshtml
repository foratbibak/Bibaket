@model Bibaket.Domain.Models.Categories.Category

@{
    ViewData["Title"] = "حذف گروه";
}


<h3>آیا از حذف @Model.Title مطمئن هستید?</h3>
<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            عنوان دسته بندی
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            عنوان در ادرس بار 
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Slug)
        </dd>
    

        <dt class = "col-sm-2">
            تاریخ ایجاد
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatDate)
        </dd>
        <dt class = "col-sm-2">
           تاریخ ویرایش
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UpdateDate)
        </dd>
        <dt class = "col-sm-2">
            تاریخ حذف
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeleteDate)
        </dd>
        <dt class = "col-sm-2">
            وضعیت حذف
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsDelete)
        </dd>
    </dl>
    <div >
        <img  src="/CategoryImages/@Model.ImageName"
             class=" border shadow-sm"
             style="width: 200px; height: 200px; object-fit: cover; cursor: pointer;"
    </div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="حذف دسته بندی" class="btn btn-danger" /> |
        <a asp-action="Index">باز گشت به لیست</a>
    </form>
</div>
