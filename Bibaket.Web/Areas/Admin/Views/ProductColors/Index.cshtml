@model IEnumerable<Sofarashel.Domain.Models.Products.ProductColor>

@{
    ViewData["Title"] = "رنگ بندی های محصول :" + ViewBag.ProductTitle;
}

<h1>رنگ بندی های محصول :@ViewBag.ProductTitle</h1>

<p>
    <a asp-route-id="@ViewBag.ProductId" asp-action="Create">افزودن</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
         
            <th>
                @Html.DisplayNameFor(model => model.Quntity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsDefault)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    <span style="color:@item.Code;">@item.Code</span>
                </td>
                <td>
                    @item.Price.ToToman()
                </td>
             
                <td>
                    @Html.DisplayFor(modelItem => item.Quntity)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsDefault)
                </td>
                <td>
                    <a asp-action="IsDefault" asp-route-id="@item.Id">پیش فرض</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">ویراش</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-controller="Products" asp-action="Index">بازگشت</a>
</div>
