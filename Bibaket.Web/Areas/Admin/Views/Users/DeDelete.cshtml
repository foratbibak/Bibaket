@model Bibaket.Domin.Models.Users.User

@{
    ViewData["Title"] = "Delete";
}

@{
    string fullName = "";
    if (Model.FirstName != "" && Model.LastName != "")
    {
        fullName = $"{Model.FirstName} {Model.LastName}";
    }
    else
    {
        fullName = Model.UserName;
    }
}
<h1>@fullName</h1>

<h3>آیا از فعال کردن کاربر  @fullName مطمئن هستید</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            نام
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class="col-sm-2">
            نام خانوادگی
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class="col-sm-2">
            نام کاربری
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
        <dt class="col-sm-2">
            ایمیل
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            شماره تلفن
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Mobile)
        </dd>
        <dt class="col-sm-2">
            کدملی
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NationalCode)
        </dd>
        <dt class="col-sm-2">
            کاربر فعال است
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class="col-sm-2">
            آخرین فعالیت
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastLoginDate)
        </dd>
        <dt class="col-sm-2">
            تاریخ ساخت
        </dt>
        <dd class="col-sm-10">
            @Model.CreatDate.ToShamsi();
        </dd>
        @if (Model.UpdateDate != null)
        {
            <dt class="col-sm-2">
                تاریخ ویرایش
            </dt>
            <dd class="col-sm-10">
                @Model.UpdateDate?.ToShamsi();
            </dd>
        }
        <dt class="col-sm-2">
            نقش های کاربر
        </dt>
        <dd class="col-sm-10">
            @(Model.UserInRole.Any() ? string.Join(" ,", Model.UserInRole.Select(r => r.Role.RoleName).ToList()) : "کاربر عادی")
        </dd>
    </dl>
    <div>
        <img src="/Avatars/@Model.Avatar" alt="">
    </div>

    <form asp-action="DeDelete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="بازگردانی " class="btn btn-info" /> |
        <a asp-action="Index">بازگشت به لیست</a>
    </form>
</div>