@model Bibaket.Domin.Models.Users.User

@{
    ViewData["Title"] = "حذف کاربر";

    string fullName = "کاربر";
    if (!string.IsNullOrEmpty(Model?.FirstName) && !string.IsNullOrEmpty(Model?.LastName))
    {
        fullName = $"{Model.FirstName} {Model.LastName}";
    }
    else if (!string.IsNullOrEmpty(Model?.UserName))
    {
        fullName = Model.UserName;
    }
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-9">

            <div class="card shadow-sm rounded-4 border-0">

                <!-- هدر با سوال حذف -->
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <div class="alert alert-warning border-0 rounded-3 mb-0 py-2 px-3 bg-warning bg-opacity-10">
                        <div class="d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                            <span class="fw-semibold">آیا از حذف کاربر @fullName مطمئن هستید؟</span>
                        </div>
                    </div>
                </div>

                <!-- بدنه با دو ستون: عکس + اطلاعات -->
                <div class="card-body p-4">
                    <div class="row g-4">

                        <!-- ستون عکس پروفایل (بزرگ) -->
                        <div class="col-md-4 text-center">
                            <div class="sticky-top" style="top: 20px;">
                                @if (!string.IsNullOrEmpty(Model?.Avatar))
                                {
                                    <img src="/Avatars/@Model.Avatar" alt="@fullName"
                                         class="rounded-3 shadow"
                                         style="width: 100%; max-width: 220px; height: auto; object-fit: cover; aspect-ratio: 1/1;">
                                }
                                else
                                {
                                    <div class="bg-light rounded-3 shadow d-flex align-items-center justify-content-center mx-auto"
                                         style="width: 100%; max-width: 220px; aspect-ratio: 1/1;">
                                        <i class="bi bi-person-fill text-secondary" style="font-size: 80px;"></i>
                                    </div>
                                }
                                <div class="mt-3">
                                    <h5 class="mb-1">@fullName</h5>
                                    <span class="badge @(Model?.IsActive == true ? "bg-success" : "bg-danger") rounded-pill px-3">
                                        @(Model?.IsActive == true ? "فعال" : "غیرفعال")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- ستون اطلاعات کامل -->
                        <div class="col-md-8">
                            <div class="row g-3">

                                <!-- اطلاعات شخصی -->
                                <div class="col-12">
                                    <h6 class="text-muted border-bottom pb-2 mb-3">
                                        <i class="bi bi-person-circle me-2"></i>اطلاعات شخصی
                                    </h6>
                                </div>

                                <div class="col-sm-6">
                                    <div class="info-box">
                                        <span class="text-muted small">نام</span>
                                        <div class="fw-semibold">@(string.IsNullOrEmpty(Model?.FirstName) ? "—" : Model.FirstName)</div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="info-box">
                                        <span class="text-muted small">نام خانوادگی</span>
                                        <div class="fw-semibold">@(string.IsNullOrEmpty(Model?.LastName) ? "—" : Model.LastName)</div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="info-box">
                                        <span class="text-muted small">نام کاربری</span>
                                        <div class="fw-semibold">@(Model?.UserName ?? "—")</div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="info-box">
                                        <span class="text-muted small">کد ملی</span>
                                        <div class="fw-semibold direction-ltr">@(string.IsNullOrEmpty(Model?.NationalCode) ? "—" : Model.NationalCode)</div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="info-box">
                                        <span class="text-muted small">ایمیل</span>
                                        <div class="fw-semibold direction-ltr">@(Model?.Email ?? "—")</div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="info-box">
                                        <span class="text-muted small">شماره تلفن</span>
                                        <div class="fw-semibold direction-ltr">@(string.IsNullOrEmpty(Model?.Mobile) ? "—" : Model.Mobile)</div>
                                    </div>
                                </div>

                                <!-- اطلاعات سیستمی -->
                                <div class="col-12 mt-2">
                                    <h6 class="text-muted border-bottom pb-2 mb-3 mt-2">
                                        <i class="bi bi-gear me-2"></i>اطلاعات سیستمی
                                    </h6>
                                </div>

                                <div class="col-sm-6">
                                    <div class="info-box">
                                        <span class="text-muted small">نقش‌های کاربر</span>
                                        <div class="fw-semibold">
                                            @{
                                                var roles = Model?.UserInRole?.Select(r => r.Role?.RoleName).Where(r => !string.IsNullOrEmpty(r)).ToList();
                                                if (roles != null && roles.Any())
                                                {
                                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                                        @foreach (var role in roles)
                                                        {
                                                            <span class="badge bg-info rounded-pill">@role</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span>کاربر عادی</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="info-box">
                                        <span class="text-muted small">آخرین فعالیت</span>
                                        <div class="fw-semibold">@(Model?.LastLoginDate?.ToShamsi() ?? "—")</div>
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="info-box">
                                        <span class="text-muted small">تاریخ ساخت</span>
                                        <div class="fw-semibold">@(Model?.CreatDate.ToShamsi() ?? "—")</div>
                                    </div>
                                </div>

                                @if (Model?.UpdateDate != null)
                                {
                                    <div class="col-sm-6">
                                        <div class="info-box">
                                            <span class="text-muted small">تاریخ ویرایش</span>
                                            <div class="fw-semibold">@Model.UpdateDate.Value.ToShamsi()</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- فوتر با دکمه‌ها -->
                <div class="card-footer bg-white border-0 pb-4 pt-0">
                    <form asp-action="Delete" id="deleteForm" class="d-flex gap-2 justify-content-end">
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-right me-1"></i>بازگشت
                        </a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4" id="confirmDeleteBtn">
                            <i class="bi bi-trash3 me-1"></i>حذف کاربر
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .info-box {
        background: #f8f9fa;
        padding: 10px 12px;
        border-radius: 12px;
        transition: all 0.2s ease;
        height: 100%;
    }

        .info-box:hover {
            background: #e9ecef;
            transform: translateX(-3px);
        }

    .direction-ltr {
        direction: ltr;
        display: inline-block;
    }

    .rounded-4 {
        border-radius: 1rem !important;
    }

    /* برای موبایل */
    @@media (max-width: 768px) {
        .info-box:hover {
            transform: none;
        }
    }
</style>

@section Scripts {
    <script>
        document.getElementById('confirmDeleteBtn')?.addEventListener('click', function(e) {
            if (!confirm('آیا از حذف این کاربر اطمینان دارید؟')) {
                e.preventDefault();
            }
        });
    </script>
}