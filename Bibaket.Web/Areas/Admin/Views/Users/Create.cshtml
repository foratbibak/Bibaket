@model Bibaket.Domain.ViewModels.User.AdminCreatUserViewModel

@{
    ViewData["Title"] = "افزودن کاربر جدید";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">@ViewData["Title"]</h4>

    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <!-- ستون اصلی اطلاعات -->
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="نام" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" placeholder="نام خانوادگی" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserName" class="form-label"></label>
                                <input asp-for="UserName" class="form-control" placeholder="نام کاربری" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="example@mail.com" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Mobile" class="form-label"></label>
                                <input asp-for="Mobile" class="form-control" placeholder="09xxxxxxxxx" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password"  class="form-control" />
                            </div>
                        </div>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" asp-for="IsActive" type="checkbox">
                            <label class="form-check-label" for="IsActive">حساب کاربری فعال باشد</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ستون عکس و نقش‌ها -->
            <div class="col-md-4">
                <div class="card mb-4 text-center">
                    <div class="card-body">
                        <div class="mb-3">
                            <img id="imgAvatar" src="/Avatars/NoPhoto.jpg" class="img-fluid rounded-circle" style="width:150px; height:150px; cursor:pointer;" onclick="$('#AvatarUp').click();" />
                        </div>
                         <input type="file" asp-for="AvatarFile" id="AvatarUp" onchange="ShowpImage(this);" style="display: none;" /> 
                        <label class="btn btn-primary" onclick="$('#AvatarUp').click();">انتخاب تصویر</label>
                    </div>
                </div>

                @if (Model.Roles.Any())
                {
                    <div class="card">
                        <div class="card-header">نقش‌های کاربر</div>
                        <div class="card-body">
                            @foreach (var item in Model.Roles)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" name="UserSelectedRoles" type="checkbox" value="@item.Id" id="role_@item.Id">
                                    <label class="form-check-label" for="role_@item.Id">@item.RoleName</label>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success px-5">ذخیره اطلاعات</button>
            <a asp-action="Index" class="btn btn-secondary">بازگشت</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function ShowpImage(input) {
           if (input.files && input.files[0]) {
              var reader = new FileReader();
              reader.onload = function (e) {
                 $('#imgAvatar').attr('src', e.target.result);
              }
              reader.readAsDataURL(input.files[0]);
           }
        }
    </script>
}
