@using Bibaket.Domain.Enums.User
@model Bibaket.Domain.ViewModels.User.AdminEditViewModel

@{
    ViewData["Title"] = "ویرایش کاربر ";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
        <i class="bx bx-user-plus me-1"></i>
        @ViewData["Title"]
    </h4>

    <div class="row g-4">
        <form asp-action="Create" class="row g-4" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <!-- ستون اصلی اطلاعات -->
            <div class="col-xl-8">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-white border-bottom-0 pt-4">
                        <h5 class="mb-0">
                            <i class="bx bx-info-circle text-primary me-1"></i>
                            اطلاعات شخصی
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">
                                    <i class="bx bx-user text-muted me-1"></i>
                                    نام
                                </label>
                                <input asp-for="FirstName" class="form-control" placeholder="مثال: فرات" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">
                                    <i class="bx bx-user-voice text-muted me-1"></i>
                                    نام خانوادگی
                                </label>
                                <input asp-for="LastName" class="form-control" placeholder="مثال: بی باک" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NationalCode" class="form-label fw-semibold">
                                    <i class="bx bx-id-card text-muted me-1"></i>
                                    کد ملی
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bx bx-id-card"></i>
                                    </span>
                                    <input asp-for="NationalCode" class="form-control border-start-0" placeholder="1234567890" />
                                </div>
                                <span asp-validation-for="NationalCode" class="text-danger small"></span>
                                <div class="form-text">کد ملی ۱۰ رقمی خود را وارد کنید</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-semibold">
                                    <i class="bx bx-at text-muted me-1"></i>
                                    نام کاربری
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bx bx-user"></i>
                                    </span>
                                    <input asp-for="UserName" class="form-control border-start-0" placeholder="alireza_123" />
                                </div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="bx bx-mail-send text-muted me-1"></i>
                                    ایمیل
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bx bx-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control border-start-0" placeholder="alireza@gmail.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Mobile" class="form-label fw-semibold">
                                    <i class="bx bx-mobile-alt text-muted me-1"></i>
                                    موبایل
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bx bx-phone"></i>
                                    </span>
                                    <input asp-for="Mobile" class="form-control border-start-0" placeholder="09123456789" />
                                </div>
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="IsActive" type="checkbox" id="IsActive" checked>
                            <label class="form-check-label fw-semibold" for="IsActive">
                                <i class="bx bx-check-circle text-success me-1"></i>
                                فعال بودن حساب کاربری
                            </label>
                            <div class="form-text ms-4">در صورت غیرفعال بودن، کاربر قادر به ورود نخواهد بود</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="IsDelete" type="checkbox" id="IsDelete" checked>
                            <label class="form-check-label fw-semibold" for="IsActive">
                                <i class="bx bx-check-circle text-success me-1"></i>
                                 حذف بودن حساب کاربری
                            </label>
                            <div class="form-text ms-4">در صورت حذف بودن، کاربر قادر به ورود نخواهد بود</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ستون عکس و نقش‌ها -->
            <div class="col-xl-4">
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-4">
                        <h5 class="mb-0">
                            <i class="bx bx-camera text-primary me-1"></i>
                            تصویر پروفایل
                        </h5>
                    </div>
                    <div class="card-body text-center">
                        <div class="position-relative d-inline-block mb-3">

                            <img id="imgAvatar" src="/Avatars/@Model.Avatar"
                                 class="rounded-circle border shadow-sm"
                                 style="width: 160px; height: 160px; object-fit: cover; cursor: pointer;"
                                 onclick="$('#AvatarUp').click();" />

                            <div class="position-absolute bottom-0 end-0 bg-primary rounded-circle p-2 shadow-sm"
                                 style="cursor: pointer;"
                                 onclick="$('#AvatarUp').click();">
                                <i class="bx bx-camera text-white" style="font-size: 14px;"></i>
                            </div>
                        </div>
                        <input type="file" asp-for="AvatarFile" id="AvatarUp" accept="image/*" onchange="previewImage(this);" style="display: none;" />
                        <div class="small text-muted">
                            <i class="bx bx-info-circle"></i>
                            فرمت‌های مجاز: JPG، PNG، GIF | حداکثر ۲ مگابایت
                        </div>
                    </div>
                </div>

                @if (Model.Roles != null && Model.Roles.Any())
                {
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white border-bottom-0 pt-4">
                            <h5 class="mb-0">
                                <i class="bx bx-group text-primary me-1"></i>
                                نقش‌های کاربر
                            </h5>
                        </div>
                        <div class="card-body">
                            @foreach (var item in Model.Roles)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" name="UserSelectedRoles" type="checkbox" value="@item.Id" @((Model.UserSelectedRoles.Any(r => r == item.Id) ? "checked" : ""))>
                                    <label class="form-check-label" for="role_@item.Id">
                                        <i class="bx bx-shield-alt text-info me-1"></i>
                                        @item.RoleName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- دکمه‌ها -->
            <div class="col-12">
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bx bx-x me-1"></i>
                        انصراف
                    </a>
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="bx bx-save me-1"></i>
                        ثبت کاربر
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#imgAvatar').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>

    <style>
        .card {
            transition: all 0.3s ease;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
            }

        .form-control, .input-group-text {
            transition: all 0.2s ease;
        }

            .form-control:focus, .input-group:focus-within {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.15);
            }

        .btn-primary {
            transition: all 0.2s ease;
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(13,110,253,0.3);
            }

        #imgAvatar {
            transition: all 0.3s ease;
        }

            #imgAvatar:hover {
                transform: scale(1.02);
                cursor: pointer;
            }

        .alert {
            border-radius: 12px;
            border: none;
        }

        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
}