@model IEnumerable<Bibaket.Domain.Models.Products.ProductFeature>

@{
    ViewData["Title"] = ViewBag.Product;
}

<h1>@ViewBag.Product</h1>

<p>
    <a  asp-route-id="@ViewBag.ProductId" asp-action="Create">افزودن</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                عنوان 
            </th>
            <th>
                مقدار
            </th>
         
         
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Value)
            </td>
   
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">ویراش</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">حذف</a>
            </td>
        </tr>
}
    </tbody>
</table>
<div>
    <a asp-controller="Products" asp-action="Index">بازگشت</a>
</div>
