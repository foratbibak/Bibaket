@model Bibaket.Domain.Models.Ads.Ads

@{
    ViewData["Title"] = "حذف بنر";
}

<h1>حذف بنر</h1>

<h3> آیا از حذف این بنر مطمئن هستید؟</h3>
<div>
    <h4>Ads</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AdsZone)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AdsZone.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Url)
        </dt>
        <dd class = "col-sm-10">
            <a href="@Model.Url" target="_blank">@Model.Url</a>
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ImageName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IBlank)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IBlank)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.StartDate?.ToShamsi()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ExpireDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.ExpireDate?.ToShamsi()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VisitCount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VisitCount)
        </dd>
     
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.CreatDate.ToShamsi()
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UpdateDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.UpdateDate?.ToShamsi()
        </dd>
     
  
    </dl>
    <dl class="row">
        <dt class="col-sm-2">

        </dt>
        <dd class="col-sm-10">
            <img class="img-thumbnail" src="~/AdsImages/@Model.ImageName" />
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index">بازگشت به لیست</a>
    </form>
</div>
