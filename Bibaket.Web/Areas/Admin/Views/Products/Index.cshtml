@using Bibaket.Domain.ViewModels.Products
@model AdminFilterProductViewModel

@{
    ViewData["Title"] = "لیست محصولات";
}

<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">محصولات /</span>لیست محصولات</h4>




<p>
    <a asp-action="Create">ثبت محصول </a>
</p>




<!-- Filter Section -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0">
            <i class="bi bi-funnel me-2"></i>
            فیلترها
        </h5>
        <button class="btn btn-sm btn-outline-secondary rounded-pill" type="button"
                data-bs-toggle="collapse" data-bs-target="#filterCardBody"
                aria-expanded="true">
            <i class="bi bi-chevron-up"></i>
            بستن
        </button>
    </div>
    <div class="collapse show" id="filterCardBody">
        <form asp-action="Index" method="get" id="filter-search" class="card-body pt-0">
            <input asp-for="PageId" type="hidden" id="PageId" />

            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Title" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Title" class="form-control" placeholder="" />
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-search me-1"></i>
                    جستجو
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    حذف فیلترها
                </a>
            </div>
        </form>
    </div>
</div>


<table class="table">
    <thead>
        <tr>
            <th>
                تصویر کالا
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                دسته بندی
            </th>
            <th>
                قیمت
            </th>
            <th>
                وضعیت
            </th>
            <th>
                تاریخ ایجاد
            </th>
            
            <th> دستورات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Entities)
        {
            <tr class="@(item.IsDelete ? "table-danger" : "")">
                <td>
                    <img src="/ProductImages/@item.ImageName"
                         class="rounded-circle object-fit-cover border"
                         style="width: 50px; height: 50px; object-fit: cover;"
                         alt="آواتار" />
                </td>
                <td>
                    @item.Title
                </td>
                <td>
                    @item.CategoryName
                </td>
                <td>
                    @item.Price.ToToman()
                </td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge rounded-pill bg-success" >فعال</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-danger"> غیر فعال</span>

                    }
                </td>
               
                <td>
                    @item.CreateDate.ToShamsi()
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsDelete)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">ویرایش </a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<!-- Pagination -->
<div class="card-footer bg-transparent border-0 pt-3">
    <partial name="_AdminPagination" model="@Model.GetCurrentPaging()" />
</div>

